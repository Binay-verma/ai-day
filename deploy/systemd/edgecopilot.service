# Bare-metal install (Raspberry Pi OS / Ubuntu / JetPack):
#   sudo useradd --system --home /opt/edgecopilot edgecopilot
#   sudo cp deploy/systemd/edgecopilot.service /etc/systemd/system/ && sudo systemctl enable --now edgecopilot
[Unit]
Description=Explainable Edge AI Copilot
After=network-online.target
Wants=network-online.target

[Service]
User=edgecopilot
WorkingDirectory=/opt/edgecopilot
EnvironmentFile=/opt/edgecopilot/.env
ExecStart=/opt/edgecopilot/.venv/bin/python -m edgecopilot.server.app --config configs/campus.yaml --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3
WatchdogSec=0
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/edgecopilot/data /opt/edgecopilot/calibration /opt/edgecopilot/logs
PrivateTmp=true
CPUQuota=190%
MemoryMax=2G

[Install]
WantedBy=multi-user.target
